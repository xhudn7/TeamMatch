@{
    ViewData["Title"] = "Team Match";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Team Match</title>

    <link rel="stylesheet" href="~/css/style.css">
</head>

<body>

    <nav class="navbar">
        <a href="/Home/Login">Login</a>
        <a href="/Home/Signup">Register</a>
        <a href="/Home/Profile">Profile</a>
    </nav>

    <header>
        <a href="#fff" class="logo">
            <h1>Team Match</h1>
        </a>
    </header>

    <section class="hero">
        <h2>Find Your Perfect Graduation Project Team</h2>
        <p>Connect with students and build your ideal project team</p>
        <a href="/Home/FindTeam" class="btn-main">Find Teammates</a>
        <a href="/Home/Signup" class="btn-secondary">Create Team</a>
    </section>

    <section class="options">
        <h2>What are you looking for?</h2>
        <a href="/Home/FindTeam" class="option-btn">Looking for Team</a>
        <a href="/Home/FindTeam" class="option-btn">Looking for Members</a>
        <a href="/Home/FindTeam" class="option-btn">I have a Project Idea</a>
    </section>

    <section class="steps">
        <div class="step">
            <h3>1. Create Profile</h3>
            <p>Add your skills and interests</p>
        </div>
        <div class="step">
            <h3>2. Find Matches</h3>
            <p>Search for students or teams</p>
        </div>
        <div class="step">
            <h3>3. Build Team</h3>
            <p>Start your graduation project</p>
        </div>
    </section>

    <section class="features" id="fff">
        <h2>Why Team Match?</h2>

        <div class="feature-box">
            <h3>Smart Matching</h3>
            <p>Find students based on skills</p>
        </div>

        <div class="feature-box">
            <h3>Easy Communication</h3>
            <p>Connect instantly</p>
        </div>

        <div class="feature-box">
            <h3>Organized Teams</h3>
            <p>Manage your project</p>
        </div>
    </section>

    <footer>
        <p>Start building your team today</p>
    </footer>

</body>
</html>